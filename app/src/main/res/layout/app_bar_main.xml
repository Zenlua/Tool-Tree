<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp"
        android:background="@android:color/transparent"
        android:theme="?android:actionBarTheme">

        <com.omarea.common.ui.BlurTopBarLayout
            android:id="@+id/blur_top_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/krscript_item_ripple_in" >
            
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:elevation="0dp"
                app:popupTheme="@style/AppTheme.PopupOverlay"
                app:subtitleTextColor="?android:textColorPrimary"
                app:titleTextColor="?android:textColorPrimary" />

            <!-- Thanh tiến trình load trang (process = true) - ẩn theo mặc định, chỉ
                 ActionPage bật lên khi trang cấu hình process = true đang tải. -->
            <ProgressBar
                android:id="@+id/page_load_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:max="100"
                android:progress="0"
                android:indeterminate="true"
                android:visibility="gone" />

        </com.omarea.common.ui.BlurTopBarLayout>

    </com.google.android.material.appbar.AppBarLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
