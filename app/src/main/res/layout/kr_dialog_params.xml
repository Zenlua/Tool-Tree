<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            style="@style/dialogTitle" />

        <TextView
            android:id="@+id/desc"
            style="@style/dialogDesc" />

        <LinearLayout
            android:id="@+id/warn_layout"
            style="@style/dialogWarnContainer"
            android:gravity="center_vertical"
            android:orientation="horizontal">
        
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginVertical="3dp"
                android:adjustViewBounds="true"
                android:src="@drawable/kr_param_warn"
                android:contentDescription="@null" />
        
            <TextView
                android:id="@+id/warn"
                style="@style/dialogWarn"
                android:paddingStart="9dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/kr_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            style="@style/textSmall" />

        <ImageView
            android:id="@+id/kr_rows_photo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/kr_params_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/top_bar" >

        <ScrollView
            android:id="@+id/kr_params_center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:requiresFadingEdge="vertical"
            android:scrollbarSize="0dp"
            android:overScrollMode="never"
            android:layout_above="@+id/bottom_actions"
            android:padding="16dp" />

        <LinearLayout
            android:id="@+id/bottom_actions"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@id/btn_cancel"
                style="@style/dialogCancelBtn"
                android:text="@string/btn_cancel" />

            <Button
                android:id="@id/btn_confirm"
                style="@style/dialogConfirmBtn"
                android:text="@string/btn_confirm" />
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
