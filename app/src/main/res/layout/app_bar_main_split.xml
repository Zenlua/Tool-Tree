<?xml version="1.0" encoding="utf-8"?>
<!--
    Toolbar riêng cho MainActivity theo giao diện "đảo nổi": tên app và 2 nút hành động
    (khởi động lại / thông tin) được tách thành 2 đảo (island) riêng biệt, nổi cách nhau
    và cách mép màn hình, thay vì dùng chung 1 Toolbar hệ thống như các màn hình khác.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/island_margin_h"
    android:paddingEnd="@dimen/island_margin_h"
    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- id blur_top_container: ThemeModeState áp status bar inset làm padding-top động ở đây,
         xem java/com/tool/tree/ThemeModeState.kt (applyWindowFlags) -->
    <LinearLayout
        android:id="@+id/blur_top_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Đảo 1: tên app - gọn theo nội dung, không kéo giãn hết chỗ trống -->
        <com.omarea.common.ui.BlurViewLinearLayout
            android:id="@+id/title_island"
            android:layout_width="wrap_content"
            android:layout_height="?attr/actionBarSize"
            android:elevation="@dimen/island_elevation"
            android:background="@drawable/krscript_item_ripple_in"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/main_title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="220dp"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Tool Tree" />

        </com.omarea.common.ui.BlurViewLinearLayout>

        <!-- Khoảng trống co giãn tự động đẩy Đảo 2 về góc phải -->
        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <!-- Đảo 2: 2 nút hành động (khởi động lại / thông tin) -->
        <com.omarea.common.ui.BlurViewLinearLayout
            android:id="@+id/actions_island"
            android:layout_width="wrap_content"
            android:layout_height="?attr/actionBarSize"
            android:elevation="@dimen/island_elevation"
            android:background="@drawable/krscript_item_ripple_in"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/btn_reboot"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="4dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/text_power_reboot"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/power"
                app:tint="?android:attr/textColorPrimary" />

            <ImageButton
                android:id="@+id/btn_info"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="4dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/about_title"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/info"
                app:tint="?android:attr/textColorPrimary" />

        </com.omarea.common.ui.BlurViewLinearLayout>

    </LinearLayout>

    <ProgressBar
        android:id="@+id/page_load_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:translationY="3dp"
        android:layout_gravity="bottom"
        android:max="100"
        android:progress="0"
        android:indeterminate="true"
        android:visibility="gone" />

</FrameLayout>
