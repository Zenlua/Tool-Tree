<?xml version="1.0" encoding="utf-8"?>
<!--
    Lưu ý: view này được dùng làm Toast.view (xem BannerNotificationManager.kt).
    Toast KHÔNG đặt view vào trong 1 ViewGroup cha khi hiển thị, nên các thuộc tính
    layout_margin... trên view gốc sẽ bị bỏ qua hoàn toàn. Vì vậy phải dùng 1 FrameLayout
    ngoài cùng với padding (padding luôn có tác dụng, không phụ thuộc parent) để tạo
    khoảng cách với mép màn hình, thay vì đặt margin trực tiếp lên banner_root.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <LinearLayout
        android:id="@+id/banner_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/banner_bg"
        android:elevation="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/banner_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top"
            android:src="@drawable/ic_banner_info" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/banner_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/banner_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:maxLines="4" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>