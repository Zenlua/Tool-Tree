<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="@drawable/krscript_item_ripple_ac"
    android:minHeight="?android:attr/listPreferredItemHeight">

    <ImageView
        android:id="@+id/kr_extra_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@id/kr_shortcut_icon"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="6dp"
        android:src="@drawable/kr_shortcut_icon"
        android:visibility="gone"
        app:tint="@color/kr_shortcut_color"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Icon bên trái -->
    <ImageView
        android:id="@id/kr_icon"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Widget bên phải -->
    <ImageView
        android:id="@id/kr_widget"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:padding="5dp"
        android:layout_marginEnd="16dp"
        android:alpha="0.9"
        app:tint="?android:attr/colorAccent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/kr_icon"
        app:layout_constraintBottom_toBottomOf="@id/kr_icon" />

    <!-- Title -->
    <TextView
        android:id="@id/kr_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        style="@style/textTitle"
        app:layout_constraintStart_toEndOf="@id/kr_icon"
        app:layout_constraintEnd_toStartOf="@id/kr_widget"
        app:layout_constraintTop_toTopOf="@id/kr_icon" />

    <!-- Desc -->
    <TextView
        android:id="@id/kr_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        style="@style/textSmall"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/kr_title"
        app:layout_constraintEnd_toEndOf="@id/kr_title"
        app:layout_constraintTop_toBottomOf="@id/kr_title" />

    <!-- Summary -->
    <TextView
        android:id="@id/kr_summary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?android:attr/colorAccent"
        style="@style/textSmall"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="@id/kr_title"
        app:layout_constraintEnd_toEndOf="@id/kr_title"
        app:layout_constraintTop_toBottomOf="@id/kr_desc" />

    <!-- Rows - Nằm ngay dưới kr_summary một cách gọn gàng -->
    <TextView
        android:id="@+id/kr_rows"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="10dp"
        style="@style/textSmall"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/kr_summary" />

    <!-- Rows Photo -->
    <ImageView
        android:id="@+id/kr_rows_photo"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/kr_rows" />

    <!-- Extra Icon -->
    <ImageView
        android:id="@+id/kr_extra_icon"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/kr_rows_photo" />

</androidx.constraintlayout.widget.ConstraintLayout>
