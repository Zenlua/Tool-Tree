<resources>
    <!-- Default screen margins, per the Android Design guidelines. -->
    <dimen name="activity_horizontal_margin">16dp</dimen>
    <dimen name="activity_vertical_margin">16dp</dimen>

    <!-- "Floating island" style: khoảng cách và độ nổi (elevation) dùng chung cho
         các thanh toolbar/tabbar dạng đảo nổi (BlurTopBarLayout/BlurBottomBarLayout). -->
    <dimen name="island_margin_h">16dp</dimen>
    <dimen name="island_margin_v">8dp</dimen>
    <dimen name="island_gap">8dp</dimen>
    <dimen name="island_elevation">6dp</dimen>

    <!-- Chặn dưới/trên cho khoảng hở đảo nổi <-> status bar/navigation bar, khi khoảng hở
         này được tính tự động theo % chiều cao inset thật của từng máy - xem
         ThemeModeState.kt (applyWindowFlags -> autoGap()). -->
    <dimen name="island_gap_min">4dp</dimen>
    <dimen name="island_gap_max">20dp</dimen>
</resources>