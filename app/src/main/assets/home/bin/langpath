# Kakathic

if [ -f "$PAGE_CONFIG_DIR/lang/default.bash" ]; then
  pathlang="$PAGE_CONFIG_DIR/lang"
else
  pathlang="$ETC/lang"
fi

if [ -f "$pathlang/${LANGUAGE}-${COUNTRY}.bash" ]; then
  echo "$pathlang/${LANGUAGE}-${COUNTRY}.bash"
elif [ -f "$pathlang/$LANGUAGE.bash" ]; then
  echo "$pathlang/$LANGUAGE.bash"
elif [ -f "$pathlang/auto.sh" ]; then
  echo "$pathlang/auto.sh"
else
  echo "$pathlang/default.bash"
fi
