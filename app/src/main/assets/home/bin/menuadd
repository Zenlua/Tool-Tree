#!/data/data/com.tool.tree/files/home/bin/bash
# Kakathic

fileprop="$1/Add-on.bash"

if [ -d "$1" ] && [ -f "$fileprop" ]; then
source language 2>/dev/null
source "$fileprop" 2>/dev/null

if [ "$google_text" ]; then
echo '
  [[group]]
  [[group.menu]]
    [[group.menu.items]]
    title = "'$google_translate_text'"
    box = "glog auto_trans_text_'$id'"
    reload = true
    silent = true
    type = "checkbox"
    script = """
      if [ "$(glog auto_trans_text_'$id')" == 1 ]; then
      slog auto_trans_text_'$id' 0
      else
      if [ "$(glog transai_text_'$id')" == 1 ]; then
      rm -fr '$1'/auto.sh
      slog transai_text_'$id' 0
      fi
      slog auto_trans_text_'$id' 1
      fi
    """
    [[group.menu.items]]
    title = "Gemini"
    box = "glog transai_text_'$id'"
    reload = true
    silent = true
    type = "checkbox"
    script = """
      if [ "$(glog transai_text_'$id')" == 1 ]; then
      slog transai_text_'$id' 0
      else
      if [ "$(glog auto_trans_text_'$id')" == 1 ]; then
      rm -fr '$1'/auto.sh
      slog auto_trans_text_'$id' 0
      fi
      transai -c && slog transai_text_'$id' 1 || showbanner -t "Gemini" -m "$(transai -c 2>&1 | trans -b)" -y error
      fi
    """
  '
fi

[ -f "$1/pin" ] && pin_text_add="$unpin_text" || pin_text_add="$pin_text"
echo '
  [[group]]
  [[group.menu]]
    [[group.menu.items]]
    title = "'$pin_text_add'"
    auto-finish = true
    silent = true
    script = """
    if [ -f "'$1'/pin" ]; then
    rm -f "'$1'/pin"
    else
    echo > "'$1'/pin"
    fi
    """
  '
fi
