# Kakathic

show_all() {
  [ "$toast" == 1 ] && showbanner -y "$1" -t "$name_add" -m "$2" || echo "$2"
}

[ -f "$1/check" ] || echo 2 > "$1/check"
check_num="$(cat "$1/check")"

if [ "$check_num" -ge 2 ]; then
  [ "$(glog show_toast_${1##*/})" == 1 ] && toast=1
  if checkonline; then
    source language 2>/dev/null
    name_add="$(gprop name $1/download.prop)"
    echo "Start checking for updates: $name_add"
    echo
    file_name="$(gprop url $1/download.prop)"
    check_sum_onl="$(xem https://api.github.com/repos/Zenlua/Tool-Tree/releases/tags/V1 | jq -r --arg name "${file_name##*/}" '.assets[] | select(.name == $name) | .digest' | cut -d: -f2)"
    if [[ "$check_sum_onl" ]] && [[ "$check_sum_onl" != "$(glog check_sum_addon_${1##*/})" ]]; then
    show_all info "$updating_text add-on: $name_add"
    installadd "$file_name" "${1%/*}" 2>&1 && show_all success "$update_text $flash_text_12: $name_add $(gprop version $1/addon.prop) ($(gprop versionCode $1/addon.prop))" || show_all error "$load_text_2 $name_add"
    fi
  else
    echo "Network error $name_add"
  fi
  echo 0 > "$1/check"
else
  echo $((check_num + 1)) > "$1/check"
fi
