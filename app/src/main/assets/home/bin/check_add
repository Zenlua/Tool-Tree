# Kakathic

show_all() {
  showbanner -y "$1" -t "$name" -m "$2"
}

if [ ! -f "$1/zcheck" ]; then
  if checkonline; then
    source language 2>/dev/null
    source "$1/download.bash" 2>/dev/null
    sumcek="$(xem https://api.github.com/repos/Zenlua/Tool-Tree/releases/tags/V1 | jq -r --arg name "${url##*/}" '.assets[] | select(.name == $name) | .digest' | cut -d: -f2)"
    if [[ "$sumcek" ]] && [[ "$sumcek" != "$(glog sumcek_$id)" ]]; then
      show_all info "$updating_text add-on: $name"
      installadd "$url" "${1%/*}" &>/dev/null
      if [ $? == 0 ]; then
        source "$1/Add-on.bash" 2>/dev/null
        touch "$1/zcheck"
        show_all success \
        "$update_text $flash_text_12: $name $version ($versionCode)"
      else
        show_all error "$load_text_2 $name"
      fi
    fi
  else
    echo "Network error $name"
  fi
fi
