#!/data/data/com.tool.tree/files/home/bin/bash

DEX="$ETC"/rish_shizuku.dex

if [ ! -f "$DEX" ]; then
  echo "Cannot find $DEX, please check the tutorial in Shizuku app"
  exit 1
fi

export RISH_APPLICATION_ID="com.tool.tree"
[ $API -ge 34 ] && chmod 400 $DEX

if [ "$1" == '-c' ] && [ "$2" ]; then
  /system/bin/app_process -Djava.class.path="$DEX" /system/bin \
  --nice-name=rish rikka.shizuku.shell.ShizukuShellLoader "$@" &
wait
else
  /system/bin/app_process -Djava.class.path="$DEX" /system/bin \
  --nice-name=rish rikka.shizuku.shell.ShizukuShellLoader "$@"
fi
