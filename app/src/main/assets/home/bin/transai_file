#!/data/data/com.tool.tree/files/home/bin/bash

file_input="$1"
file_ouput="$2"
chunk_size=100
current_line=1
total_lines=$(wc -l < "$file_input")

if [ ! -f "$file_input" ] && [ -z "$file_ouput" ]; then
  echo "Next file, or output file name" >&2
  exit 1
fi

if [ "$total_lines" -gt 200 ]; then
  echo -n > "$file_ouput"
  while [ "$current_line" -le "$total_lines" ]; do
    transcc=""; retry_count=0
    end_line=$(( current_line + chunk_size - 1 ))
    [ "$end_line" -gt "$total_lines" ] && end_line=$total_lines
    chunk="$(awk "NR>=$current_line && NR<=$end_line" "$file_input")"
    echo "Processing from the line $current_line > $end_line..."
    while [ -z "$transcc" ] || [ "$transcc" = "null" ]; do
      transcc="$(transai "$chunk")"
      if [ -z "$transcc" ] || [ "$transcc" = "null" ]; then
        echo "  -> Transai is null, trying again...."
        if [ "$retry_count" -ge 10 ]; then
          echo "  [Error] Tried 10 times but the API still returns null. I stopped the entire program !"
          exit 1
        fi
        sleep 1
      fi
    done
    printf '%s\n' "$transcc" >> "$file_ouput"
    current_line=$(( end_line + 1 ))
  done
else
  transai "$(cat "$file_input")" > "$file_ouput"
fi

