# Kakathic

if [ -n "$shell_progres" ]; then
    if [ -n "$1" ]; then
    echo "progress:[$1]"
    else
    echo "For: progress 1/100"
    fi
else
    spin=('▪▫▫▫' '▫▪▫▫' '▫▫▪▫' '▫▫▫▪' '▫▫▫▫')
    if [ -n "$1" ]; then
    cur="${1%/*}"
    max="${1#*/}"
    icon="${spin[$((cur % ${#spin[@]}))]}"
    echo -ne " $icon ${cur}/${max}\r"
    [ "$cur" -eq "$max" ] && echo -e " ✔ ${cur}/${max}\n"
    else
    echo "For: progress 1/100"
    fi
fi
